<Project>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <!-- Only for tools/Umbraco.Abilities.ModelRun, which runs a real model against the samples -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageVersion Include="Anthropic" Version="13.8.0" />
    <!-- Only for tools/Umbraco.Abilities.McpProxy, a stand-in for the Umbraco CMS MCP Dev server -->
    <PackageVersion Include="ModelContextProtocol" Version="2.3.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <!-- The version an Umbraco 18 site already resolves (through NPoco.SqlServer), so retries add nothing new. -->
    <PackageVersion Include="Polly.Core" Version="8.5.0" />
    <!-- Real Umbraco CMS, for the CMS document adapter and its integration tests -->
    <PackageVersion Include="Umbraco.Cms.Core" Version="[18.0.0,19)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[18.0.0,19)" />
    <!-- For the Management API endpoints that expose abilities over HTTP -->
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.0.0,19)" />
    <PackageVersion Include="Umbraco.Cms.Tests.Integration" Version="[18.0.0,19)" />
    <!--
      Umbraco 18.0.0 pulls 10.0.0 in through MailKit and MimeKit, which has two denial of service advisories
      (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx), fixed in 10.0.13.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- Resolves NU1107 between Umbraco.Cms.Tests.Integration and its Roslyn dependencies -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
