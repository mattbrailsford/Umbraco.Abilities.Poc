<Project>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <!-- Only for tools/Umbraco.Abilities.ModelRun, which runs a real model against the samples -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageVersion Include="Anthropic" Version="13.8.0" />
    <!-- Only for tools/Umbraco.Abilities.McpProxy, a stand-in for the Umbraco CMS MCP Dev server -->
    <PackageVersion Include="ModelContextProtocol" Version="2.3.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <!-- The version an Umbraco 18 site already resolves (through NPoco.SqlServer), so retries add nothing new. -->
    <PackageVersion Include="Polly.Core" Version="8.5.0" />
    <!-- Real Umbraco CMS, for the CMS document adapter and its integration tests -->
    <PackageVersion Include="Umbraco.Cms.Core" Version="[18.0.0,19)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[18.0.0,19)" />
    <!-- For the Management API endpoints that expose abilities over HTTP -->
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.0.0,19)" />
    <!-- Only for demo/Umbraco.Abilities.Demo, a site to try the MCP proxy against -->
    <PackageVersion Include="Umbraco.Cms" Version="[18.0.0,19)" />
    <!-- Only for the demo: Paul Seal's Clean starter kit, for document types with blocks. 8.0.1 needs Umbraco 18.0.1+ -->
    <PackageVersion Include="Clean" Version="8.0.1" />
    <!-- Umbraco Commerce for Umbraco 18. No licence is needed for local development. -->
    <PackageVersion Include="Umbraco.Commerce" Version="18.1.11" />
    <PackageVersion Include="Umbraco.Commerce.Core" Version="18.1.11" />
    <PackageVersion Include="Umbraco.Commerce.Persistence.Sqlite" Version="18.1.11" />
    <!--
      Commerce's migrations use dbup-sqlserver, built against Microsoft.Data.SqlClient 5, which brought Azure.Identity
      (and Azure.Core). Umbraco 18.3 uses SqlClient 7, which doesn't, and Umbraco loads every referenced assembly at
      start, so the site fails without them.
    -->
    <PackageVersion Include="Azure.Identity" Version="1.13.1" />
    <!--
      Only for the demo. Umbraco 18.3 asks for SQLite's native library 2.1.13, whose SQLite rejects text in double quotes
      (SQLITE_DQS off; 2.1.12 does too). One of Commerce 18.1.11's SQLite migrations (20240516090000) writes
      "$.fraction" that way, so it fails on every start, Umbraco never finishes starting, and the demo isn't seeded.
      2.1.11 (SQLite 3.49.1) still accepts it. Local demo only: remove once Commerce's migration is fixed (umbraco/Umbraco.Commerce.Issues#923).
    -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.11" />
    <!-- Umbraco Automate for Umbraco 18, for the ability loader that registers abilities as Automate actions. -->
    <PackageVersion Include="Umbraco.Automate" Version="18.6.0" />
    <PackageVersion Include="Umbraco.Automate.Core" Version="18.6.0" />
    <PackageVersion Include="Umbraco.Cms.Tests.Integration" Version="[18.0.0,19)" />
    <!--
      Umbraco 18.0.0 pulls 10.0.0 in through MailKit and MimeKit, which has two denial of service advisories
      (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx), fixed in 10.0.13.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- Resolves NU1107 between Umbraco.Cms.Tests.Integration and its Roslyn dependencies -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageVersion Include="Corvus.Json.Validator" Version="5.8.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
