{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umbraco.com/abilities/entity-schema.metaschema.json",
  "$dynamicAnchor": "meta",
  "title": "Entity schema",
  "description": "JSON Schema 2020-12 plus the x- keywords the framework adds. $dynamicAnchor makes every nested schema follow these rules too. Any other x- keyword is a mistake.",
  "allOf": [{ "$ref": "https://json-schema.org/draft/2020-12/schema" }],
  "properties": {
    "format": {
      "description": "One of JSON Schema's own formats, or a package's own as owner.name in lower case.",
      "anyOf": [
        { "enum": ["date-time", "date", "time", "duration", "email", "idn-email", "hostname", "idn-hostname", "ipv4", "ipv6", "uri", "uri-reference", "iri", "iri-reference", "uuid", "uri-template", "json-pointer", "relative-json-pointer", "regex"] },
        { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" }
      ]
    },
    "x-edit": { "type": "string" },
    "x-bindings": { "const": true },
    "x-variations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "x-references": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }]
    },
    "x-references-item-in": { "type": "string" },
    "x-editor": {
      "type": "object",
      "properties": {
        "alias": { "type": "string", "minLength": 1 },
        "config": { "type": "object" }
      },
      "required": ["alias"],
      "additionalProperties": false
    },
    "x-meta": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
      "additionalProperties": { "type": "object" }
    },
    "x-hints": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "x-item-types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": { "type": "string" },
          "group": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["alias", "group", "name"],
        "additionalProperties": false
      }
    }
  },
  "patternProperties": {
    "^x-(?!(edit|bindings|variations|references|references-item-in|item-types|editor|meta|hints)$)": false
  }
}
