    },
    {
      "type": "modal",
      "alias": "Umb.Abilities.Modal.EntityPicker",
      "name": "Abilities: entity picker dialog",
      "element": "/App_Plugins/UmbracoAbilitiesUI/entity-picker-modal.js"
    }
  ]
}
