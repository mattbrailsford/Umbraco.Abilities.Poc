<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Abilities over the Management API: list them, and call one. For HTTP callers such as the Umbraco CMS MCP Dev server.
    It reuses the AI tool shape (schema, change set argument, result) so an HTTP caller sees what a model sees.
  -->
  <PropertyGroup>
    <!--
      Umbraco.Cms.Api.Management 18.0.0 brings in MessagePack, Microsoft.OpenApi and System.Security.Cryptography.Xml
      versions with advisories. They are Umbraco's to update; this proof of concept doesn't upgrade them.
    -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Umbraco.Abilities/Umbraco.Abilities.csproj" />
    <ProjectReference Include="../Umbraco.Abilities.AI/Umbraco.Abilities.AI.csproj" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
</Project>
