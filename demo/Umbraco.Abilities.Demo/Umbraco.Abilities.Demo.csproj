<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    A small Umbraco 18 site to try the abilities against by hand: SQLite, installed on first run, with the abilities,
    their Management API endpoints, the Clean starter kit, real Umbraco Commerce with a seeded store, Umbraco Automate with
    every ability as an action, and an API user for the MCP proxy. See README.md.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Umbraco 18 brings in packages with advisories. They are Umbraco's to update; the demo doesn't upgrade them. -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <CompressionEnabled>false</CompressionEnabled>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Umbraco.Abilities.Cms/Umbraco.Abilities.Cms.csproj" />
    <ProjectReference Include="../../src/Umbraco.Abilities.Commerce/Umbraco.Abilities.Commerce.csproj" />
    <ProjectReference Include="../../src/Umbraco.Abilities.ManagementApi/Umbraco.Abilities.ManagementApi.csproj" />
    <ProjectReference Include="../../src/Umbraco.Abilities.Automate/Umbraco.Abilities.Automate.csproj" />
    <!--
      The rest of the repo builds against 18.0.0. The demo runs 18.3.0: Clean needs 18.0.1 or later, and 18.3.0 fixes
      the multi-node tree picker's value schema (umbraco/Umbraco-CMS#23760).
    -->
    <PackageReference Include="Umbraco.Cms" VersionOverride="[18.3.0,19)" />
    <PackageReference Include="Clean" />
    <PackageReference Include="Umbraco.Commerce" />
    <PackageReference Include="Umbraco.Commerce.Persistence.Sqlite" />
    <PackageReference Include="Umbraco.Automate" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
</Project>
