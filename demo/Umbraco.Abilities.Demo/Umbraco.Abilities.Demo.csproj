<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    A small Umbraco 18 site to try the abilities against by hand: SQLite, installed on first run, with the abilities,
    their Management API endpoints, an article document type and an API user for the MCP proxy. See README.md.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Umbraco 18.0.0 brings in packages with advisories. They are Umbraco's to update; the demo doesn't upgrade them. -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <CompressionEnabled>false</CompressionEnabled>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Umbraco.Abilities.Cms/Umbraco.Abilities.Cms.csproj" />
    <ProjectReference Include="../../src/Umbraco.Abilities.ManagementApi/Umbraco.Abilities.ManagementApi.csproj" />
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
</Project>
